
@{
    ViewBag.Title = "Tickets";
    ViewData["selectedNav"] = "AdminTicket";
    Layout = "~/Views/Layout/AdminLayout.cshtml";


    var cultureInfo = new System.Globalization.CultureInfo("vi-VN");
    cultureInfo.NumberFormat.CurrencyDecimalDigits = 0;
}

@Html.AntiForgeryToken()
<div class="container d-flex justify-content-between align-items-center my-1">
    @for (int i = 0; i < 10; i++)
    {
        <a href="/ticket/index?variance=@i" style="width: 8%" class="bg-white py-1 px-2 rounded-1 @(ViewBag.variance == i ? "border border-2 border-black" : "")">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-7">@DateTime.Now.AddDays(i).Month</div>
                    <div class="fs-7">@DateTime.Now.AddDays(i).ToString("ddd")</div>
                </div>
                <div class="fs-5 fw-bold ">
                    @DateTime.Now.AddDays(i).Day
                </div>
            </div>
        </a>
    }
</div>
<table id="movies" class="table">
    <thead>
        <tr>
            <th>Movie</th>
            <th>Ticket</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ABCDMall.Models.Movie movie in ViewBag.movies)
        {
            <tr>
                <td class="" style="width: 200px;">
                    <img src="~/Assets/Images/Movie/@movie.Image" class="w-100 h-100" />
                </td>
                <td>
                    <div class="d-flex flex-wrap h-100 bg-white rounded-1 px-4 py-3">
                        <div class="d-flex fw-bold w-100 mb-2">
                            <div class="fs-7" style="width: 7%">Cinema</div>
                            <div class="fs-7" style="width: 5%">Seat</div>
                            <div class="fs-7" style="width: 20%">Starting Time</div>
                            <div class="fs-7" style="width: 18%">Customer Name</div>
                            <div class="fs-7" style="width: 20%">Customer Email</div>
                            <div class="fs-7" style="width: 10%">Price</div>
                            <div class="fs-7" style="width: 20%">Payment Time</div>
                        </div>
                        <div class="vstack gap-3 overflow-auto" style="height: 200px">
                            @foreach (ABCDMall.Models.Showtime showtime in movie.Showtimes)
                            {
                                if ((DateTime)showtime.StartingTime.Date == ViewBag.date.Date)
                                {
                                    foreach (ABCDMall.Models.Ticket ticket in showtime.Tickets)
                                    {
                                        <div class="d-flex">
                                            <div class="fw-bold fs-7" style="width: 7%">@ticket.Showtime1.Cinema</div>
                                            <div class="fw-bold fs-7" style="width: 5%">@ticket.Seat1.Name</div>
                                            <div class="fs-7"  style="width: 20%">@ticket.Showtime1.StartingTime</div>
                                            <div class="fs-7" style="width: 18%">@ticket.CustomerName</div>
                                            <div class="fs-7" style="width: 20%">@ticket.CustomerEmail</div>
                                            <div class="fs-7" style="width: 10%">@ticket.Price.ToString("C", cultureInfo)</div>
                                            <div class="fs-7" style="width: 20%">@ticket.PaymentTime</div>
                                        </div>
                                    }

                                }
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
<script src="~/Scripts/Showtime/index.js"></script>

