    
@{
    ViewBag.Title = "Manage Movies";
    ViewData["selectedNav"] = "AdminMovies";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

@Html.AntiForgeryToken()
<a class="btn btn-success" href="/movie/add">Add new movie</a>
<table id="movies" class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Image</th>
            <th>Director</th>
            <th data-dt-order="disable">Genres</th>
            <th>Release Date</th>
            <th>Duration</th>
            <th data-dt-order="disable">Description</th>
            <th data-dt-order="disable">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ABCDMall.Models.Movie movie in ViewBag.movies)
        {
            if (movie.Active != 0)
            {
                <tr>
                    <td>@movie.Name</td>
                    <td>
                        <img src="~/Assets/Images/Movie/@movie.Image" height="100px" width="auto" />
                    </td>
                    <td>@movie.Director</td>
                    <td>@string.Join(", ", movie.Genres.Select(genre => genre.Name))</td>
                    <td data-order="@movie.RealeaseDate.Ticks">@movie.RealeaseDate.ToString("dd/MM/yyyy")</td>
                    <td>@movie.Duration</td>
                    <td style="text-align: justify">@movie.Description</td>
                    <td>
                        <a class="btn btn-primary" href="/movie/update?id=@movie.ID">Update</a>
                        @if (movie.Showtimes.Any(showtime => showtime.Tickets.Count > 0))
                        {
                        <button class="btn btn-danger" onclick="disableMovie('@movie.ID')">Delete</button>
                        }
                        else
                        {
                        <button class="btn btn-danger" onclick="deleteMovie('@movie.ID')">Delete</button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<script src="~/Scripts/Movie/index.js"></script>
