<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <link href="~/Content/mycss.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

    <link href="~/Content/myStyle.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <script src="~/Scripts/popper.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>

    <link href="https://cdn.datatables.net/v/bs5/dt-2.1.8/datatables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.8/datatables.min.js"></script>
</head>
<body>
    <div class="row gx-0">
        <nav class="vh-100 col-2 p-3">
            <div class="d-flex mb-3">
                <a href="/admin/index">
                    <div class="fw-bold d-flex justify-content-around">
                        <img src="~/Assets/Images/logo.png" class="w-50">
                    </div>
                </a>
            </div>
            <div class="vstack gap-2">
                <a href="/gallery/index" class="item-nav @(ViewData["selectedNav"].ToString() == "AdminGallery" ? "item-nav-selected" : "")">
                    <div>
                        <i class="fa-solid fa-images"></i>
                    </div>
                    <div class="fw-bold d-flex">
                        Gallery
                    </div>
                </a>
                <a href="/shoppingcenters/index" class="item-nav @(ViewData["selectedNav"].ToString() == "AdminShoppingCenters" ? "item-nav-selected" : "")">
                    <div>
                        <i class="fa-solid fa-shop"></i>
                    </div>
                    <div class="fw-bold d-flex">
                        Shopping Centers
                    </div>
                </a>
                <a href="/foodcourts/index" class="item-nav @(ViewData["selectedNav"].ToString() == "AdminFoodCourts" ? "item-nav-selected" : "")">
                    <div>
                        <i class="fa-solid fa-pizza-slice"></i>
                    </div>
                    <div class="fw-bold d-flex">
                        Food Courts
                    </div>
                </a>
                <a href="/movie/index" class="item-nav @(ViewData["selectedNav"].ToString() == "AdminMovies" ? "item-nav-selected" : "")">
                    <div>
                        <i class="fa-solid fa-film"></i>
                    </div>
                    <div class="fw-bold d-flex">
                        Movies
                    </div>
                </a>
                <a href="/feedback/index" class="item-nav @(ViewData["selectedNav"].ToString() == "AdminFeedback" ? "item-nav-selected" : "")">
                    <div>
                        <i class="fa-solid fa-comments"></i>
                    </div>
                    <div class="fw-bold d-flex">
                        Feedback
                    </div>
                </a>
            </div>
        </nav>
        <div class="vh-100 bg-light col-10">
            <header class="bg-white d-flex px-4 py-2 justify-content-between align-items-center">
                <div class="fs-4 fw-bold">@ViewBag.Title</div>
                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-end">
                        <div class="dropdown no-focus-visible">
                            <button class="btn p-1 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-circle-user fs-4"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item dropdown-item-custom d-flex align-items-center" href="/admin/logout">
                                        <i style="width: 20px;" class="me-3 fa-solid fa-arrow-right-from-bracket"></i>
                                        <span>Logout</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </header>
            <div>
                @RenderBody()
            </div>
        </div>
    </div>
</body>
</html>
