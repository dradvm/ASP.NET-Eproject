
@{
    ViewBag.Title = "Menu";
    ViewData["selectedNav"] = "AdminMenu";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

<h2>Manage Products</h2>

<a name="" id="" class="btn btn-success" href="@Url.Action("Add", "menu")" role="button">
    <i class="fas fa-plus"></i> Add New Shopping Items
</a>

<table class="table table-striped table-bordered" id="Menu">
    <thead class="thead-dark">
        <tr>

            <th>Name</th>
            <th>Image</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ABCDMall.Models.Product pro in ViewBag.products)
         {
                <tr>

                <td> @pro.Name </td>
                <td >
                    <img src="~/Assets/Images/Product/@pro.Image" alt = "Error" class="img-thumbnail" style="max-width: 100px" />
                </td>
                <td>@pro.Description</td>
                <td>
                    <div class="btn-group" style="gap: 10px;">
                        <a class="btn btn-primary" href="/shoppingitems/update?id=@pro.ID">Update</a>
                        <button class="btn btn-danger" onclick="deleteShopItemsEntry('@pro.ID')">Delete</button>
                    </div>

                </td>
            </tr>
              
        }
    </tbody>
</table>
@*<script src="~/Scripts/ShopItems/index.js"></script>*@