
@{
    ViewBag.Title = "TestResult";
    ViewData["selectedNav"] = "Result";
    Layout = "~/Views/Layout/Layout.cshtml";
}

<div class="d-flex justify-content-around align-items-center mt-5 flex-column">
    @if (@ViewBag.Status)
    {
        <div>
            <div class="text-center text-white bg-black fw-bold py-2 w-100 fs-5">TICKETS INFORMATION</div>
            <div class="bg-primary text-white px-3 py-1">
                <div class="fw-bold">
                    Cinema @ViewBag.showtime.Cinema1.Name
                </div>
                <div class="fw-bold">
                    @ViewBag.showtime.StartingTime.ToString("dd/mm/yyyy HH:mm") ~ @ViewBag.showtime.EndingTime.ToString("dd/mm/yyyy HH:mm")

                </div>
            </div>
            <table border="1" class="w-100">
                <thead>
                <th>Seat</th>
                <th>Seat Type</th>
                <th>Price</th>
                </thead>
                <tbody>
                    @foreach (ABCDMall.Models.Ticket ticket in ViewBag.tickets)
                    {
                        <tr>
                            <td>
                                @ticket.Seat1.Name
                            </td>
                            <td>
                                @ticket.Seat1.SeatType1.Name
                            </td>
                            <td>
                                @ticket.Seat1.SeatType1.Price
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-secondary px-5 mx-5">Error System, Please Try Again!</div>
    }
    <a class="fs-7 fw-bold text-white bg-main px-3 py-2 rounded-1 mt-3" href="/home/index">Back to Home</a>

</div>
