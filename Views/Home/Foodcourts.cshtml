@{
    ViewBag.Title = "Foodcourts";
    ViewData["selectedNav"] = "Foodcourts";
    Layout = "~/Views/Layout/Layout.cshtml";
}

<link href="~/Content/foodcss.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

<div class="container my-5">
    <div class="row">
        <!-- Cột chính -->
        <div class="col-md-9 mx-auto">
            <!-- Thanh tìm kiếm -->
            <div class="d-flex justify-content-between align-items-center bg-secondary p-3 mb-3">
                <input type="text" class="form-control w-75" placeholder="Search content...">
                <button class="btn btn-primary ms-3">Tìm kiếm</button>
            </div>

            <!-- Danh sách cửa hàng -->
            <div class="row g-3">
                @foreach (ABCDMall.Models.Shop shop in ViewBag.shops)
                {
                    <div class="col-md-3">
                        <div class="card h-100" style="max-height: 280px;">
                            <!-- Logo cửa hàng -->
                            <img src="~/Assets/Images/Shop/@shop.Logo" class="card-img-top" alt="@shop.Name"
                                 style="height: 170px; object-fit: cover;">
                            <!-- Thông tin cửa hàng -->
                            <div class="card-body">
                                <h5 class="card-title text-dark text-truncate">@shop.Name</h5>
                            </div>
                            <!-- Footer với nút chi tiết -->
                            <div class="card-footer bg-white border-0">
                                <a href="@Url.Action("ShopDetails", "Home", new { id = shop.ID })"
                                   class="btn btn-primary w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


