
@{
    ViewBag.Title = "Index";
    ViewData["selectedNav"] = "Home";
    Layout = "~/Views/Layout/Layout.cshtml";
}

<div class="container">
    <div class="row my-row gy-4">
        @foreach (ABCDMall.Models.Gallery gallery in ViewBag.gallery)
        {
            <div class="col-md-3">
                <div class="border border-secondary-subtle border-3 shadow position-relative">
                    <img src="~/Assets/Images/Gallery/@gallery.Image" width="100%" height="250px"/>
                    <div class="position-absolute w-100 h-100 top-0 start-0 " style="background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 100%);"></div>
                    <div class="position-absolute bottom-0 fw-bold text-white ms-2 mb-1 truncate-2-lines" style=" width: 95%">@gallery.Description</div>
                </div>
            </div>
        }
    </div>
</div>