@{
    ViewBag.Title = "Update Food Court";
    ViewData["selectedNav"] = "AdminFoodCourts";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}


<div class="px-4 pt-4">
    <form method="post" action="/foodcourts/update" enctype="multipart/form-data" class="d-flex justify-content-between align-items-center">
        @Html.AntiForgeryToken()

        <input type="hidden" name="ID" value="@Model.ID" />

        <div style="width: 30%">
            <div class="vstack gap-3">
                <div class="w-100" style="height: 300px; border: 1px solid #ccc;">
                    <img id="preview" src="~/Assets/Images/Shop/@Model.Logo" class="w-100 h-100" style="object-fit: contain;" />
                </div>
                <input class="d-none" id="Logo" name="Logo" type="file" accept="image/*" onchange="loadImagePreview()" />
                <button type="button" class="my-btn bg-main text-white px-3 py-1 rounded-1 mt-3" onclick="triggerFileInput()">Select Logo</button>
            </div>
        </div>

        <div style="width: 60%">
            <div class="d-flex justify-content-between">
                <div style="width: 90%">
                    <label for="Name" class="form-label fs-7 fw-bold" style="margin-bottom: 0;">Name</label>
                    <div class="input-group my-input-form">
                        <span class="input-group-text"><i class="fa-solid fa-shop"></i></span>
                        <input name="Name" type="text" class="form-control" placeholder="Name" value="@Model.Name" required />
                    </div>
                </div>
                <div style="width: 10%">
                    <div class="input-group my-input-form ">
                        <span class="input-group-text"><i class="fa-solid fa-shop"></i></span>
                        <input type="hidden" name="ShopTypeID" value="2" />
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <label for="Description" class="form-label fs-7 fw-bold">Description</label>
                <textarea class="form-control" name="Description" id="Description" rows="3" required>@Model.Description</textarea>
            </div>

            <div class="mt-3">
                <label class="fs-7 fw-bold">Floor</label>
                <div class="d-flex align-items-center">
                    @for (int i = 1; i <= 3; i++)
                    {
                        <div class="form-check me-3">
                            <input class="form-check-input" type="radio" name="Floor" id="floor@i" value="@i" @(i == Model.Floor ? "checked" : "") required />
                            <label class="form-check-label" for="floor@i">@i</label>
                        </div>
                    }
                </div>
            </div>

            <div class="text-danger mt-3">
                @if (ViewBag.status != null)
                {
                    if (ViewBag.status == 0)
                    {
                        <div>Name cannot be empty</div>
                    }
                    else if (ViewBag.status == -1)
                    {
                        <div>An image must be chosen</div>
                    }
                    else if (ViewBag.status == -2)
                    {
                        <div>The chosen image format is not supported</div>
                    }
                }
            </div>

            <button type="submit" class="w-100 mt-3 text-decoration-none my-btn bg-main text-white px-3 py-1 rounded-1">
                Update
            </button>
        </div>
    </form>
</div>

<script>function triggerFileInput() {
        document.getElementById("Logo").click();
    }

    function loadImagePreview() {
        const input = document.getElementById("Logo");
        const preview = document.getElementById("preview");
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }</script>

