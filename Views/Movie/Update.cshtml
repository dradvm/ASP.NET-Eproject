
@{
    ViewBag.Title = "Update Movie";
    ViewData["selectedNav"] = "AdminMovies";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}
<div class="px-4 pt-4">
    <form method="post" action="/movie/update" enctype="multipart/form-data" class="d-flex justify-content-between align-items-center">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@(((ABCDMall.Models.Movie) ViewBag.movie).ID)" />

        <div style="width: 30%">
            <div class="vstack gap-3">
                <div class="w-100" style="height: 400px">
                    <img id="preview" src="~/Assets/Images/Movie/@(((ABCDMall.Models.Movie) ViewBag.movie).Image)" class="w-100 h-100" />
                </div>
                <input class="d-none" id="image" name="image" type="file" accept=".png, .jpg, .jpeg, .svg" onchange="loadImage('/Assets/Images/Movie/@(((ABCDMall.Models.Movie) ViewBag.movie).Image)')" />
                <button type="button" class="my-btn bg-main text-white px-3 py-1 rounded-1 mt-3" onclick="triggerFileInput()">Select Image</button>
            </div>
        </div>
        <div style="width: 60%">
            <div class="d-flex justify-content-between">
                <div style="width: 32%">
                    <label for="name" class="form-label fs-7 fw-bold"
                           style="margin-bottom: 0;">
                        Name
                    </label>
                    <div class="input-group my-input-form">
                        <span class="input-group-text"><i class="fa-solid fa-film"></i></span>
                        <input name="name" type="text" class="form-control" placeholder="Name" required value="@(((ABCDMall.Models.Movie) ViewBag.movie).Name)">
                    </div>
                </div>
                <div style="width: 32%">

                    <label for="director" class="form-label fs-7 fw-bold"
                           style="margin-bottom: 0;">
                        Director
                    </label>
                    <div class="input-group my-input-form">
                        <span class="input-group-text"><i class="fa-solid fa-clapperboard"></i></span>
                        <input name="director" type="text" class="form-control" placeholder="Director" required value="@(((ABCDMall.Models.Movie) ViewBag.movie).Director)">
                    </div>
                </div>

                <div style="width: 32%">
                    <label for="duration" class="form-label fs-7 fw-bold" style="margin-bottom: 0;">Duration: </label>
                    <div class="input-group my-input-form">
                        <span class="input-group-text"><i class="fa-solid fa-hourglass"></i></span>
                        <input name="duration" class="form-control" type="number" value="@(((ABCDMall.Models.Movie) ViewBag.movie).Duration)" min="1" required />
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <label for="genres" class="form-label fs-7 fw-bold">Genres: </label>
                <div class="row">
                    @foreach (ABCDMall.Models.Genre genre in ViewBag.genres)
                    {
                        <div class="col-3">
                            <input id="genre@(genre.ID)" type="checkbox" name="genres" value="@genre.ID" checked="@(((ABCDMall.Models.Movie)ViewBag.movie).Genres.Contains(genre))" />
                            <label for="genre@(genre.ID)">@genre.Name</label>
                        </div>
                    }
                </div>

            </div>
            <div class="mt-3">
                <label for="releaseDate" class="form-label fs-7 fw-bold">Release Date: </label>
                <input class="form-control" type="date" name="releaseDate" value="@(((ABCDMall.Models.Movie) ViewBag.movie).RealeaseDate.ToString("yyyy-MM-dd"))" required />
            </div>
            <div class="mt-3">
                <label for="description" class="form-label fs-7 fw-bold">Description: </label>
                <div>
                    <textarea class="form-control" name="description" required>@(((ABCDMall.Models.Movie) ViewBag.movie).Description)</textarea>
                </div>
            </div>

            <div class="text-danger mt-1">
                @switch (ViewBag.status)
                {
                    case 0:
                        <div>Name cannot be empty or filled with only spaces</div>
                        break;
                    case -1:
                        <div>An image must be chosen</div>
                        break;
                    case -2:
                        <div>Director cannot be empty or filled with only spaces</div>
                        break;
                    case -3:
                        <div>At least 1 genre must be chosen</div>
                        break;
                    case -4:
                        <div>Release date must be chosen</div>
                        break;
                    case -5:
                        <div>Duration must be greater than 0</div>
                        break;
                    case -6:
                        <div>Description cannot be empty or filled with only spaces</div>
                        break;
                    case -7:
                        <div>The selected image format is not supported</div>
                        break;
                    case -8:
                        <div>The selected image size must be less than 10MB</div>
                        break;
                    case -9:
                        <div>System error, please try again</div>
                        break;
                }
            </div>
            <button type="submit" class="w-100 mt-3 text-decoration-none my-btn bg-main text-white px-3 py-1 rounded-1">
                Update
            </button>
        </div>

    </form>
    <script src="~/Scripts/Movie/update.js"></script>
</div>

<script>
    function triggerFileInput() {
        document.getElementById("image").click();
    }
</script>