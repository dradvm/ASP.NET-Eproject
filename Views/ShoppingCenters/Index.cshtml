
@{
    ViewBag.Title = "Manage Shopping Centers";
    ViewData["selectedNav"] = "AdminShop";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

<link href="~/Content/myStyle.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

@Html.AntiForgeryToken()
<a name="" id="" class="btn btn-success" href="@Url.Action("Add", "ShoppingCenters")" role="button">
    <i class="fas fa-plus"></i> Add New Shopping Center
</a>

<table class="table table-striped table-bordered" id="shoppingCenters">
    <thead class="thead-dark">
        <tr>
            <th>ShopeType</th>
            <th>Floor</th>
            <th>Name</th>
            <th>Logo</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ABCDMall.Models.Shop shop in ViewBag.shops)
        {
            <tr>
                <td>@shop.ShopType.Name</td>  <!-- Lấy tên ShopType thay vì ID -->
                <td>@shop.Floor</td>
                <td>@shop.Name</td>
                <td>
                    <img src="~/Assets/Images/Shop/@shop.Logo" alt="Error" class="img-thumbnail" style="max-width: 100px" />
                </td>
                <td>@shop.Description</td>
                <td>

                    <div class="btn-group" style="gap: 10px;">
                        <a class="btn btn-primary" href="/shoppingcenters/update?id=@shop.ID">Update</a>
                        <button class="btn btn-danger" onclick="deleteShopEntry('@shop.ID')">Delete </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<script src="~/Scripts/ShopCenters/index.js"></script>