
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

<h2>Trang admin crud shopping center</h2>

<a name="" id="" class="btn btn-primary" href="@Url.Action("Add", "ShoppingCenters")" role="button">
    <i class="fas fa-plus"></i> Add
</a>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>ID</th>
            <th>ShopeType</th>
            <th>Floor</th>
            <th>Name</th>
            <th>Logo</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ABCDMall.Models.Shop shop in ViewBag.shops)
        {
            <tr>
                <td scope="row">@shop.ID</td>
                <td>@shop.ShopeType</td>
                <td>
                    <img src="@shop.Logo" class="img-thumbnail" style="max-width: 100px;" />
                </td>
                <td>@shop.Name</td>
                <td>@shop.Logo</td>
                <td>@shop.Description</td>
                <td>
                    <div class="btn-group">
                        <a href="@Url.Action("Edit", new { id = shop.ID })" class="btn btn-primary btn-sm" title="Edit">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a href="@Url.Action("Delete", new { id = shop.ID })" class="btn btn-danger btn-sm" title="Delete">
                            <i class="fas fa-trash-alt"></i> Delete
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>