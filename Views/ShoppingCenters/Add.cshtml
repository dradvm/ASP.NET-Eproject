
@{
    ViewBag.Title = "Add";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

<h2>Add trang shopping center</h2>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Add", "Shop", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <!-- Shoptype -->
                    <div class="form-group">
                        <label for="shop_type">Danh mục:</label>
                        <select class="form-control" name="shop_type" id="shop_type">
                            @foreach (var shops in (IEnumerable<SelectListItem>)ViewBag.shops)
                            {
                                <option value="@shops.Value">@shops.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- Product Quantity -->
                    <div class="form-group">
                        <label for="Floor">Số tầng:</label>
                        <input type="number" class="form-control" name="Floor" id="Floor" required />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <!-- Product Price -->
                    <div class="form-group">
                        <label for="Name">Tên:</label>
                        <input type="text" class="form-control" name="Name" id="Name" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- Product Image -->
                    <div class="form-group">
                        <label for="Logo">Hình ảnh:</label>
                        <input type="file" name="Logo" id="Logo" class="form-control-file" accept="image/*" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <!-- Product Description -->
                    <div class="form-group">
                        <label for="Description">Mô tả:</label>
                        <input type="text" class="form-control" name="Description" id="Description" />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success">Create</button>
            </div>
            <div class="d-flex justify-content-start mt-2">
                <a href="/ShoppingCenters/Index" class="btn btn-danger">Quay lại danh sách</a>
            </div>
        }
    </div>
</div>

