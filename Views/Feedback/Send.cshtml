
@{
    ViewBag.Title = "Send Feedback";
    ViewData["selectedNav"] = "SendFeedback";
    Layout = "~/Views/Layout/Layout.cshtml";
}

<form action="/feedback/send" method="post" class="px-5 mx-5 mt-5">
    @Html.AntiForgeryToken()
    <label for="email" class="form-label fs-7 fw-bold"
           style="margin-bottom: 0;">Email (optional): </label>
    <div class="input-group my-input-form ">
        <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
        <input name="email" type="email" class="form-control" />
    </div>
    <div class="mt-3">
        <label for="content" class="form-label fs-7 fw-bold">Description: </label>
        <div>
            <textarea class="form-control" name=content" required rows="10"></textarea>
        </div>
    </div>
    @if (ViewBag.status == -1)
    {
        <div>Invalid email</div>
    }
    else if (ViewBag.status == 0)
    {
        <div>Feedback content must be filled</div>
    }
    else if (ViewBag.status == 2)
    {
        <div>Your feedback has been sent</div>
    }
    <button type="submit" class="w-100 mt-3 text-decoration-none my-btn bg-main text-white px-3 py-1 rounded-1">
        Update
    </button>
</form>

