
@{
    ViewBag.Title = "Update Gallery Entry";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

<form method="post" enctype="multipart/form-data" action="/gallery/update">
    <input type="hidden" name="id" value="@(((ABCDMall.Models.Gallery) ViewBag.gallery).ID)"/>
    <label for="image">Image: </label>
    <input id="image" type="file" name="image" onchange="loadImage('/Assets/Images/Gallery/@(((ABCDMall.Models.Gallery) ViewBag.gallery).Image)')" accept=".jpg, .jpeg, .png, .svg" />
    <img id="preview" src="~/Assets/Images/Gallery/@(((ABCDMall.Models.Gallery) ViewBag.gallery).Image)" height="200px" width="auto" />
    <label for="description">Description: </label>
    <input name="description" value="@(((ABCDMall.Models.Gallery) ViewBag.gallery).Description)"/>
    @if (ViewBag.status == 0)
    {
        <div>Image size must be less than 10MB</div>
    }
    else if (ViewBag.status == -1)
    {
        <div>The chosen image format is not supported</div>
    }
    <button>Edit</button>
</form>
<script src="~/Scripts/Gallery/update.js"></script>


