
@{
    ViewBag.Title = "Manage Shooping Items";
    ViewData["selectedNav"] = "AdminShopItems";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

<link href="~/Content/myStyle.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

@Html.AntiForgeryToken()
<a name="" id="" class="btn btn-success" href="@Url.Action("Add", "ShoppingItems")" role="button">
    <i class="fas fa-plus"></i> Add New Shopping Item
</a>

<table class="table table-striped table-bordered" id="shoppingItems">
    <thead class="thead-dark">
        <tr>
            <th>Shop</th>
            <th>Name</th>
            <th>Image</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ABCDMall.Models.Product pro in ViewBag.shoppingitems)
        {
            <tr>
                <td>@pro.Shop1.Name</td>  <!-- Lấy tên ShopType thay vì ID -->
                <td>@pro.Name</td>
                <td>
                    <img src="~/Assets/Images/Product/@pro.Image" alt="Error" class="img-thumbnail" style="max-width: 100px" />
                </td>
                <td>@pro.Description</td>
                <td>
                    <div class="btn-group" style="gap: 10px;">
                        <a class="btn btn-primary" href="/shoppingitems/update?id=@pro.ID">Update</a>
                        <button class="btn btn-danger" onclick="deleteShopItemsEntry('@pro.ID')">Delete</button>
                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>
<script src="~/Scripts/ShopItems/index.js"></script>