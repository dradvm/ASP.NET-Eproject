
@{
    ViewBag.Title = "Cinema";
    ViewData["selectedNav"] = "AdminShowtime";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}


@Html.AntiForgeryToken()
<table id="cinemas" class="table table-striped">
    <thead>
        <tr>
            <th>Cinema</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (ABCDMall.Models.Cinema cinema in ViewBag.Cinema)
        {
            <tr>
                <td class="fw-bold">Cinema @cinema.ID</td>
                <td>
                    <a class="btn btn-primary" href="/showtime/showtime?cinema=@cinema.ID">Select</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script src="~/Scripts/Showtime/index.js"></script>